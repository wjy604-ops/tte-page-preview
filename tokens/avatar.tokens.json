{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "TTE Avatar Component Tokens",
  "version": "0.1.0",
  "source": { "base": "shadcn/ui Avatar", "evidence": "20 / 24 / 32 / 40 / 48 与 AvatarGroup" },
  "component": {
    "avatar": {
      "sizes": { "$value": ["20px", "24px", "32px", "40px", "48px"] },
      "radius": { "$type": "dimension", "$value": "{radius.full}" },
      "groupOverlap": { "$type": "dimension", "$value": "-8px" }
    }
  }
}
