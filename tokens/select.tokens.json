{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "TTE Select Component Tokens",
  "version": "0.1.0",
  "source": { "base": "shadcn/ui Select + Combobox Multiple", "evidence": "触发器对齐 Input，菜单项复用 Dropdown 选中语义" },
  "component": {
    "select": {
      "triggerHeight": { "$type": "dimension", "$value": "36px" },
